defmodule Password do
  @moduledoc """
  What to store in place of a password, and how to check one against it.

  A stored password is the PBKDF2-HMAC-SHA256 key of the password under a
  fresh random salt, written with the salt and the count of iterations as
  $pbkdf2-sha256$i=600000$salt$key. Everything needed to check a password
  is in that text, so the count can be raised later without losing the
  passwords already stored.

      alx> stored = Password.hash("correct horse", [iterations: 1000])
      alx> String.starts_with?(stored, "$pbkdf2-sha256$i=1000$")
      true
      alx> Password.verify("correct horse", stored)
      true
      alx> Password.verify("battery staple", stored)
      false
  """
  require "alchem" "v0.3.8"

  @scheme "pbkdf2-sha256"
  @iterations 600000
  @most_iterations 100000000
  @salt_bytes 16
  @key_bytes 32

  @doc """
  The text to store for a password, with 600,000 iterations. The same
  password gives a different text each time, since the salt is random.
  """
  def hash(password: string): string do
    derive(password, @iterations)
  end

  @doc """
  The text to store for a password, with [iterations: n] setting the count
  of iterations. Each guess at the password costs an attacker that much
  work, and each login costs the server the same.

      alx> Password.hash("a b", [iterations: 10]) == Password.hash("a b", [iterations: 10])
      false
  """
  def hash(password: string, options: list[tuple[atom, integer]]): string do
    iterations = Enum.reduce(options, @iterations, fn {name, value}, _ ->
      if name != :iterations do
        raise("Password.hash takes iterations:, not " <> Atom.to_string(name) <> ":")
      end
      value
    end)
    if iterations < 1 or iterations > @most_iterations do
      raise("Password.hash takes from 1 to " <> Integer.to_string(@most_iterations) <> " iterations")
    end
    derive(password, iterations)
  end

  @doc """
  Whether a password is the one a stored text was made from. The comparison
  takes the same time whether or not the password is right. Text that is
  not a stored password matches no password.

      alx> Password.verify("anything", "not a stored password")
      false
  """
  def verify(password: string, stored: string): boolean do
    case String.split(stored, "$") do
      ["", scheme, count, salt_text, key_text] ->
        fields = {Integer.parse(String.replace_prefix(count, "i=", "")), Base.decode64(salt_text, [padding: false]), Base.decode64(key_text, [padding: false])}
        case fields do
          {ok(iterations), some(salt), some(key)} ->
            size = byte_size(key)
            if scheme != @scheme or not String.starts_with?(count, "i=") or iterations < 1 or iterations > @most_iterations or size < 1 or size > 1024 do
              false
            else
              Crypto.secure_compare(Crypto.pbkdf2(:sha256, password, salt, iterations, size), key)
            end
          _ -> false
        end
      _ -> false
    end
  end

  defp derive(password: string, iterations: integer): string do
    salt = Crypto.strong_rand_bytes(@salt_bytes)
    key = Crypto.pbkdf2(:sha256, password, salt, iterations, @key_bytes)
    "$" <> @scheme <> "$i=" <> Integer.to_string(iterations) <> "$" <> Base.encode64(salt, [padding: false]) <> "$" <> Base.encode64(key, [padding: false])
  end
end
