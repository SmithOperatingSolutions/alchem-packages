defmodule PasswordTest do
  import "password.alc"
  doctest Password

  test "a stored password verifies only its own password" do
    stored = Password.hash("hunter2")
    assert(String.starts_with?(stored, "$pbkdf2-sha256$i=600000$"))
    assert(Password.verify("hunter2", stored))
    refute(Password.verify("hunter3", stored))
    refute(Password.verify("", stored))
  end

  test "the count of iterations is chosen and kept in the text" do
    quick = Password.hash("a b", [iterations: 10])
    assert(String.starts_with?(quick, "$pbkdf2-sha256$i=10$"))
    assert(Password.verify("a b", quick))
    assert(quick != Password.hash("a b", [iterations: 10]))
    assert_raise("Password.hash takes iterations:", fn -> Password.hash("a", [rounds: 10]) end)
    assert_raise("Password.hash takes from 1 to", fn -> Password.hash("a", [iterations: 0]) end)
  end

  test "text that is not a stored password matches nothing" do
    quick = Password.hash("a b", [iterations: 10])
    Enum.each([
      "",
      "junk",
      "$pbkdf2-sha256$i=10$$",
      "$pbkdf2-sha256$i=0$c2FsdA$a2V5",
      "$pbkdf2-sha256$i=x$c2FsdA$a2V5",
      "$pbkdf2-sha256$i=10x$c2FsdA$a2V5",
      "$pbkdf2-sha256$i=10$!$a2V5",
      "$pbkdf2-sha256$i=10$c2FsdA$!",
      "$bcrypt$i=10$c2FsdA$a2V5",
      String.replace(quick, "i=10", "i=11")
    ], fn text -> refute(Password.verify("a b", text)) end)
  end

  test "passwords stored by the library's own functions still verify" do
    # A key made with the published PBKDF2 vector's inputs: "password",
    # "salt", 4096 iterations, 32 bytes.
    key = Crypto.pbkdf2(:sha256, "password", "salt", 4096, 32)
    stored = "$pbkdf2-sha256$i=4096$" <> Base.encode64("salt", [padding: false]) <> "$" <> Base.encode64(key, [padding: false])
    assert(Password.verify("password", stored))
    refute(Password.verify("Password", stored))
    assert(Crypto.verify_password("password", stored))
    assert(Crypto.verify_password("x", Password.hash("x", [iterations: 5])))
    assert(Password.verify("y", Crypto.hash_password("y", [iterations: 5])))
  end
end
